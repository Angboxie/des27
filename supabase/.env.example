# Secret settings for the OPEN CITY server code.
# Copy this file to supabase/.env (which git ignores), fill it in, then run:
#   npx supabase secrets set --env-file supabase/.env
# Never commit the real values or paste them into chat, email or the website.

# Stripe > Developers > API keys. Use the sk_test_ key until you are ready to go live.
STRIPE_SECRET_KEY=sk_test_...
# Stripe > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (emails). Leave blank to hold emails in the queue for now.
RESEND_API_KEY=
MAIL_FROM=DES OPEN CITY <opencity@your-domain>
MAIL_REPLY_TO=des.unimelb@gmail.com

# The DES site's address (no /open-city/ on the end). The first one is used in emails.
SITE_URLS=https://YOUR-SITE,http://localhost:8080

# Any long random text (40+ characters). The Google Sheet uses it to read the data.
SHEET_TOKEN=
