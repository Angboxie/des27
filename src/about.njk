---
layout: layouts/base.njk
title: About DES
navLabel: About & Join
theme: des27
styles:
  - /assets/css/events.css
  - /assets/css/learn.css
  - /assets/css/about.css
scripts:
  - /assets/js/events.js
---
{# About DES and how to join. The join link and contact details live in _data/site.json ("join"). #}
{% set join = site.join %}
{% set arrow = '<svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>' %}

{% set heroScript = "About" %}
{% set heroTags = ["Socials", "industry nights", "workshops", "&amp; more"] %}
{% set heroIntro = ["The student society", "for Bachelor of Design", "at Melbourne."] %}
{% set heroLinks = [{ label: "Join DES", url: "#join" }, { label: "See events", url: "/events/" }] %}
{% include "partials/des27-hero.njk" %}

{# ---------- Who we are ---------- #}
<section class="ed-section ed-section--cream" aria-labelledby="who-title">
  <div class="des-container ab-who">
    <div>
      <h2 id="who-title" class="ev-heading reveal">
        <span class="ev-heading__big">Who</span>
        <span class="ev-heading__script script">we are</span>
      </h2>
      <div class="ed-prose reveal" style="--delay: 120ms">
        <p>Design Student Society (DES) is an ABP affiliated, student-run club at the University of Melbourne. Since its inception, DES has been dedicated to representing all Bachelor of Design students and their associated Masters programs.</p>
        <p>We aim to foster a fun and welcoming environment for students from all backgrounds. Our committee is large and full of friendly faces, so feel free to approach us at any time with questions or concerns!</p>
        <p>We host a mix of social and networking events throughout the academic year. From our outstanding Design Ball to Industry Nights, there&rsquo;s bound to be an event for you, whether you want to get to know other students or meet design industry professionals.</p>
      </div>
    </div>

    <ul class="ab-facts" aria-label="DES in numbers">
      <li class="reveal" style="--delay: 100ms"><strong>600+</strong><span>members across design and its Masters programs</span></li>
      <li class="reveal" style="--delay: 180ms"><strong>12</strong><span>Bachelor of Design majors, one community</span></li>
      <li class="reveal" style="--delay: 260ms"><strong>ABP</strong><span>affiliated club, based at the Melbourne School of Design</span></li>
      <li class="reveal" style="--delay: 340ms"><strong>Every year</strong><span>O-Week camp, the cruise, Industry Night and the Design Ball</span></li>
    </ul>
  </div>
</section>

{# ---------- Club aims ---------- #}
<section class="ed-section" aria-labelledby="aims-title">
  <div class="des-container">
    <h2 id="aims-title" class="ev-heading reveal">
      <span class="ev-heading__big">Our</span>
      <span class="ev-heading__script script">aims</span>
    </h2>
    <ol class="ab-aims">
      {% for aim in [
        "Provide academic assistance to all students in the Bachelor of Design.",
        "Provide a social network for all students in the Bachelor of Design.",
        "Help first-year Bachelor of Design students make the transition into university life.",
        "Share information and opportunities from the Bachelor of Design with our members.",
        "Promote the opportunities offered by the 12 course majors and their associated clubs.",
        "Unite Bachelor of Design students across all year levels within their chosen majors."
      ] %}
        <li class="reveal" style="--delay: {{ (loop.index0 % 3) * 90 }}ms"><span class="ab-aims__num" aria-hidden="true">{{ "0" + loop.index }}</span><p>{{ aim }}</p></li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ---------- Committee (from _data/committee.json; add a "photo" path to replace the initials) ---------- #}
<section class="ed-section ed-section--cream" aria-labelledby="committee-title">
  <div class="des-container">
    <div class="ed-head">
      <h2 id="committee-title" class="ev-heading reveal">
        <span class="ev-heading__big">Meet the</span>
        <span class="ev-heading__script script">Committee</span>
      </h2>
      <p class="ed-head__text reveal" style="--delay: 120ms">Friendly faces you can<br>come to with anything.</p>
    </div>

    {# split into Executive / Directors / Officers by the teamGroups filter in .eleventy.js #}
    {% for group in committee | teamGroups %}
    <h3 class="ab-group ab-group--{{ group.key }} reveal">{{ group.label }}</h3>
    <ul class="ab-committee">
      {% for person in group.people %}
        {% set parts = person.name.split(" ") %}
        <li class="ab-member reveal" style="--delay: {{ (loop.index0 % 4) * 70 }}ms">
          <span class="ab-member__photo" aria-hidden="true">
            {% if person.photo %}<img src="{{ person.photo }}" alt="" loading="lazy">{% else %}{{ parts[0][0] }}{{ parts[parts.length - 1][0] }}{% endif %}
          </span>
          <span class="ab-member__text">
            <strong class="ab-member__name">{{ person.name }}{% if person.goesBy %} <span class="ab-member__aka">aka {{ person.goesBy }}</span>{% endif %}</strong>
            <span class="ab-member__role">{{ person.role }}</span>
          </span>
        </li>
      {% endfor %}
    </ul>
    {% endfor %}
  </div>
</section>

{# ---------- Join ---------- #}
<section class="ed-band ab-join" id="join" data-cursor="light" aria-labelledby="join-title">
  <div class="des-container ab-join__inner">
    <h2 id="join-title" class="ev-heading ev-heading--center reveal">
      <span class="ev-heading__big">Join</span>
      <span class="ev-heading__script script">DES</span>
    </h2>
    <p class="ab-join__text reveal" style="--delay: 120ms">Joining DES is the easiest way to find your people in design. You&rsquo;ll hear first about camp, the cruise, the Design Ball and Industry Night, meet students from every major, get help when studio gets tough, and meet the professionals you&rsquo;ll be working alongside one day.</p>

    <a class="ev-btn ed-btn--lime ab-join__btn reveal" data-magnetic style="--delay: 220ms" href="{{ join.url }}" target="_blank" rel="noopener">
      Join DES on UMSU
      {{ arrow | safe }}
    </a>
    <p class="ab-join__note reveal" style="--delay: 300ms">Membership is through UMSU. Log in with your University of Melbourne account to sign up.</p>

    <ul class="ab-join__contact reveal" style="--delay: 360ms" aria-label="Contact DES">
      <li><a href="mailto:{{ join.email }}">{{ join.email }}</a></li>
      <li><a href="{{ join.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
      <li><a href="{{ join.facebook }}" target="_blank" rel="noopener">Facebook</a></li>
    </ul>
  </div>
</section>
