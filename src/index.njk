---
layout: layouts/base.njk
title: Home
---
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card %}

<section class="hero">
  <div class="container">
    <h1>{{ site.name }}</h1>
    <p class="hero__intro placeholder">[Homepage introduction to be confirmed]</p>

    <div class="button-row">
      {{ button("View events", "/events/") }}
      {{ button("About DES", "/about/", "secondary") }}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header">
      <h2>Upcoming events</h2>
      <a href="/events/">All events</a>
    </div>

    {% set upcoming = events | upcomingEvents | limit(3) %}
    {% if upcoming.length %}
      <div class="grid">
        {% for event in upcoming %}
          {% set meta = (event.date | readableDate) + " · " + (event.location or "Location TBC") %}
          {{ card({ title: event.title, meta: meta, text: event.summary, image: event.image, url: event.link }) }}
        {% endfor %}
      </div>
    {% else %}
      <p class="empty-state">No upcoming events right now.</p>
    {% endif %}
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section__header">
      <h2>Partners</h2>
      <a href="/partners/">All partners</a>
    </div>

    <div class="grid">
      {% for partner in partners | limit(3) %}
        {{ card({ title: partner.name, image: partner.logo, url: partner.website }) }}
      {% endfor %}
    </div>
  </div>
</section>
