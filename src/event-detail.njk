---
layout: layouts/base.njk
theme: des27
styles:
  - /assets/css/events.css
  - /assets/css/learn.css
scripts:
  - /assets/js/events.js
  - /assets/js/learn.js
pagination:
  data: events
  size: 1
  alias: event
permalink: "/events/{{ event.id }}/"
eleventyComputed:
  title: "{{ event.title }}"
---
{# One page per event in _data/events.json #}
{% set parts = event | titleParts %}
{% set reg = event.registration %}
{% set isPast = event.status == "past" %}

<section class="ev-featured ed-event-hero" data-cursor="light" aria-labelledby="event-title">
  <div class="ev-featured__glow" aria-hidden="true"></div>
  <svg class="ev-featured__curve draw-line" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path pathLength="1" d="M400 20 C 250 40, 150 120, 120 260 C 105 330, 70 380, 10 420" />
  </svg>

  <div class="ev-featured__media">
    {% if event.image %}<img src="{{ event.image }}" alt="">{% else %}<div class="media-placeholder"></div>{% endif %}
  </div>

  <div class="des-container ev-featured__inner">
    <div class="ev-featured__content">
      <a class="ed-back reveal" href="/events/">
        <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M22 6H3M8 1 3 6l5 5" /></svg>
        All events
      </a>
      <p class="ev-eyebrow reveal">{% if isPast %}Past event{% elif event.flagship %}Flagship competition{% else %}Upcoming event{% endif %}</p>
      <h1 id="event-title" class="ev-featured__title">
        <span class="ev-featured__big reveal" style="--delay: 100ms">{{ parts.big }}</span>
        {% if parts.script %}<span class="script ev-featured__script reveal" style="--delay: 220ms">{{ parts.script }}</span>{% endif %}
      </h1>

      {% if (reg and not isPast) or event.requested %}
        <p class="ed-pills reveal" style="--delay: 280ms">
          {% if reg and not isPast %}<span class="ed-pill ed-pill--{{ reg.status }}">{{ reg.status | registrationLabel }}</span>{% endif %}
          {% if event.requested %}<span class="ed-pill ed-pill--asked">You asked, we're delivering</span>{% endif %}
        </p>
      {% endif %}

      <p class="ev-featured__text reveal" style="--delay: 320ms">{{ event.summary }}</p>

      {% if not isPast %}
        <div class="ed-actions reveal" style="--delay: 420ms">
          {% if reg.status == "open" and reg.url %}
            <a class="ev-btn ed-btn--lime" data-magnetic href="{{ reg.url }}" target="_blank" rel="noopener">
              Register now
              <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
            </a>
          {% elif reg.status == "open" %}
            <span class="ev-btn ed-btn--lime is-disabled" aria-disabled="true">Registration link soon</span>
          {% endif %}

          {% if not event.dateDisplay %}
          <details class="ed-cal">
            <summary class="ev-btn">
              Add to calendar
              <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
            </summary>
            <div class="ed-cal__menu">
              <a href="{{ event | googleCalendarLink }}" target="_blank" rel="noopener">Google Calendar</a>
              <a href="/events/{{ event.id }}/event.ics" download>Apple / Outlook (.ics)</a>
            </div>
          </details>
          {% endif %}

          {% if reg.status == "coming-soon" or event.flagship %}
            {% if event.remindUrl %}
              <a class="ev-btn" data-magnetic href="{{ event.remindUrl }}" target="_blank" rel="noopener">Remind me</a>
            {% else %}
              <span class="ev-btn is-disabled" aria-disabled="true">Remind me (soon)</span>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    </div>

    <p class="ev-featured__date reveal" style="--delay: 200ms">
      <time datetime="{{ event.date }}">
        <span class="ev-featured__month">{{ event.dateDisplay.big if event.dateDisplay else (event.date | datePart("month")) }}</span>
        <span class="ev-featured__day script">{{ event.dateDisplay.script if event.dateDisplay else (event.date | datePart("day")) }}</span>
      </time>
    </p>
  </div>
</section>

<section class="ed-section ed-section--cream">
  <div class="des-container ed-event-grid">
    <div class="ed-event-main">
      <h2 class="ev-heading reveal">
        <span class="ev-heading__big">{% if isPast %}Event{% else %}About{% endif %}</span>
        <span class="ev-heading__script script">{% if isPast %}Recap{% else %}the Event{% endif %}</span>
      </h2>
      <div class="ed-prose reveal" style="--delay: 120ms">
        <p>{{ event.recap if isPast and event.recap else (event.description or event.summary) }}</p>
      </div>

      {% if event.details %}
        {% set d = event.details %}
        {% if d.brief %}
          <div class="ed-block reveal">
            <h3>Competition brief</h3>
            <p>{{ d.brief }}</p>
          </div>
        {% endif %}
        {% if d.keyDates %}
          <div class="ed-block reveal">
            <h3>Important dates</h3>
            <ol class="ed-timeline">
              {% for item in d.keyDates %}
                <li style="--i: {{ loop.index0 }}">
                  {% if item.when %}<span class="ed-timeline__when">{{ item.when }}</span>{% else %}<time datetime="{{ item.date }}">{{ item.date | datePart("month") }} <span class="script">{{ item.date | datePart("day") }}</span></time>{% endif %}
                  <span>{{ item.label }}</span>
                </li>
              {% endfor %}
            </ol>
          </div>
        {% endif %}
        <div class="ed-block-row">
          {% if d.eligibility %}
            <div class="ed-block reveal">
              <h3>Eligibility</h3>
              <ul class="ed-list">{% for item in d.eligibility %}<li>{{ item }}</li>{% endfor %}</ul>
            </div>
          {% endif %}
          {% if d.prizes %}
            <div class="ed-block reveal" style="--delay: 60ms">
              <h3>Prizes</h3>
              <ul class="ed-list">{% for item in d.prizes %}<li>{{ item }}</li>{% endfor %}</ul>
            </div>
          {% endif %}
          {% if d.submission %}
            <div class="ed-block reveal" style="--delay: 120ms">
              <h3>Submission requirements</h3>
              <ul class="ed-list">{% for item in d.submission %}<li>{{ item }}</li>{% endfor %}</ul>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <aside class="ed-info reveal" style="--delay: 150ms" aria-label="Event details">
      <h2 class="ed-info__title">Details</h2>
      <dl>
        <div><dt>Date</dt><dd>{% if event.dateDisplay %}{{ event.dateDisplay.text }}{% else %}{{ event.date | datePart("weekday") }}, {{ event.date | readableDate }}{% endif %}{% if event.dateNote %}<small class="ed-info__note">{{ event.dateNote }}</small>{% endif %}</dd></div>
        {% if event.startTime %}<div><dt>Time</dt><dd>{{ event.startTime }}{% if event.endTime %} – {{ event.endTime }}{% endif %}</dd></div>{% endif %}
        <div><dt>Location</dt><dd>{{ event.location or "TBC" }}</dd></div>
        {% if reg and not isPast %}
          <div><dt>Registration</dt><dd><span class="ed-pill ed-pill--{{ reg.status }}">{{ reg.status | registrationLabel }}</span></dd></div>
          {% if reg.deadline %}<div><dt>Register by</dt><dd>{{ reg.deadline | readableDate }}</dd></div>{% endif %}
        {% endif %}
      </dl>
      {% if not isPast and not event.dateDisplay %}
        <a class="des-btn ed-info__cal" href="/events/{{ event.id }}/event.ics" download>
          Add to calendar
          <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
        </a>
      {% endif %}
    </aside>
  </div>
</section>

{% if event.gallery and event.gallery.length %}
<section class="ed-section" aria-labelledby="gallery-title">
  <div class="des-container">
    <h2 id="gallery-title" class="ev-heading reveal">
      <span class="ev-heading__big">Photo</span>
      <span class="ev-heading__script script">Gallery</span>
    </h2>
    <ul class="ed-gallery" data-lightbox>
      {% for photo in event.gallery %}
        <li class="reveal" style="--delay: {{ (loop.index0 % 3) * 90 }}ms">
          <a class="ed-gallery__item" href="{{ photo }}" data-lightbox-item data-caption="{{ event.title }} – photo {{ loop.index }}">
            <img src="{{ photo }}" alt="{{ event.title }} photo {{ loop.index }}" loading="lazy">
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
