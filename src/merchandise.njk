---
layout: layouts/base.njk
title: Merchandise
theme: des27
styles:
  - /assets/css/events.css
  - /assets/css/merch.css
scripts:
  - /assets/js/events.js
---
{# Wendy's merch page design (Merch Draft 2). Content lives in _data/merchandise.json.
   Display only for now - ordering/payments will be added later. #}
{% set hero = merchandise.hero %}
{% set newIn = merchandise.newIn %}
{% set inStock = merchandise.inStock %}
{% set release = merchandise.specialRelease %}

{# ---------- Hero ---------- #}
<section class="mh-hero" data-cursor="light" aria-labelledby="merch-title">
  <div class="mh-hero__media" aria-hidden="true">
    {% if hero.image %}<img src="{{ hero.image }}" alt="">{% else %}<div class="mh-hero__placeholder"></div>{% endif %}
  </div>

  <svg class="mh-hero__line draw-line" viewBox="0 0 498 180" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M262 24 C 330 2, 420 0, 470 30 C 490 42, 500 60, 510 76" />
    <path pathLength="1" d="M-4 140 C 15 132, 40 124, 62 120" />
  </svg>

  <h1 id="merch-title" class="mh-hero__title">
    <span class="mh-hero__big" aria-hidden="true">
      {%- for letter in "DES CLUB" | list -%}
        {% if letter == " " %} {% else %}<span class="ev-letter" style="--i: {{ loop.index0 }}">{{ letter }}</span>{% endif %}
      {%- endfor -%}
    </span>
    <span class="visually-hidden">DES Club merch</span>
  </h1>

  <p class="mh-hero__tags reveal" style="--delay: 600ms">{% for tag in hero.tags %}{{ tag }}{% if not loop.last %},<br>{% endif %}{% endfor %}</p>

  <p class="mh-hero__word script" aria-hidden="true">
    {%- for letter in "merch" | list -%}<span class="mh-letter" style="--i: {{ loop.index0 }}">{{ letter }}</span>{%- endfor -%}
  </p>
</section>

{# ---------- New in ---------- #}
<section class="mn" aria-labelledby="new-in-title">
  <svg class="mn__lines draw-line" viewBox="0 0 498 253" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M395 44 C 430 36, 470 22, 500 20" />
    <path pathLength="1" d="M-4 228 C 50 200, 130 196, 190 212 C 230 224, 260 240, 275 258" />
  </svg>

  <div class="mn__head">
    <h2 id="new-in-title" class="mn__title reveal">New in</h2>
    <p class="mn__label reveal" style="--delay: 120ms">{{ newIn.label }}</p>
  </div>

  <div class="mn-carousel" data-carousel>
    <ul class="mn-track" data-carousel-track data-cursor-label="Drag">
      {% for item in newIn.items %}
        <li class="mn-item reveal" style="--delay: {{ loop.index0 * 100 }}ms">
          <a class="mn-item__link" href="{{ item.link or '#' }}" aria-label="{{ item.name }}" draggable="false">
            {% if item.image %}<img src="{{ item.image }}" alt="" loading="lazy" draggable="false">{% else %}<span class="media-placeholder"></span>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>

    <div class="mn-controls">
      <button class="mn-btn" data-magnetic type="button" data-carousel-prev aria-label="Previous">
        <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M22 6H3M8 1 3 6l5 5" /></svg>
      </button>
      <div class="mn-dots" data-carousel-dots></div>
      <button class="mn-btn" data-magnetic type="button" data-carousel-next aria-label="Next">
        <svg viewBox="0 0 24 12" aria-hidden="true"><path d="M2 6h19M16 1l5 5-5 5" /></svg>
      </button>
    </div>
  </div>
</section>

{# ---------- In stock now ---------- #}
<section class="ms" data-cursor="light" aria-labelledby="in-stock-title">
  <svg class="ms__lines draw-line" viewBox="0 0 498 306" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M-4 100 C 40 40, 140 30, 180 66" />
    <path pathLength="1" d="M-4 200 C 30 260, 80 296, 140 310" />
    <path pathLength="1" d="M502 20 C 492 34, 484 46, 478 60" />
  </svg>

  <h2 id="in-stock-title" class="ms__title reveal">
    <span class="ms__title-big">In stock</span>
    <span class="ms__title-script script">NOW</span>
  </h2>

  <a class="ms-browse reveal" data-magnetic style="--delay: 150ms" href="{{ inStock.browseAllLink or '#' }}">
      Browse all
      <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
  </a>

  <div class="ms-carousel" data-carousel>
    <ul class="ms-track" data-carousel-track data-cursor-label="Drag">
      {% for item in inStock.items %}
        <li class="ms-card reveal" style="--delay: {{ loop.index0 * 90 }}ms">
          <div class="ms-card__media">
            {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy" draggable="false">{% endif %}
          </div>
          <div class="ms-card__body">
            <h3 class="ms-card__name">{{ item.name }}</h3>
            <p class="ms-card__price">{% if item.price %}${{ item.price }} AUD{% else %}$ AUD{% endif %}</p>
            <a class="ms-card__link" href="{{ item.link or '#' }}" aria-label="{{ item.name }} details">
              <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
            </a>
          </div>
        </li>
      {% endfor %}
    </ul>

    <div class="ms-progress" data-carousel-progress aria-hidden="true"><span></span></div>
  </div>
</section>

{# ---------- Special release ---------- #}
<section class="sr" data-cursor="light" aria-labelledby="release-title">
  <div class="sr__media" aria-hidden="true">
    {% if release.image %}<img src="{{ release.image }}" alt="" loading="lazy">{% else %}<div class="sr__placeholder"></div>{% endif %}
  </div>

  <p class="sr__title script reveal" aria-hidden="true">
    {%- for letter in release.title | list -%}<span class="sr-letter" style="--i: {{ loop.index0 }}">{{ letter }}</span>{%- endfor -%}
  </p>

  {% if release.imageCutout %}<img class="sr__cutout" src="{{ release.imageCutout }}" alt="" loading="lazy">{% endif %}

  <p class="sr__date reveal" style="--delay: 200ms">
    <time datetime="{{ release.date }}">
      <span class="sr__month">{{ release.date | datePart("month") }}</span>
      <span class="sr__day script">{{ release.date | datePart("day") }}</span>
    </time>
  </p>

  <h2 id="release-title" class="sr__label reveal" style="--delay: 300ms">{{ release.label }}<span class="visually-hidden">: {{ release.title }}</span></h2>

  <a class="sr__btn reveal" data-magnetic style="--delay: 450ms" href="{{ release.link or '#' }}">
    {{ release.buttonLabel }}
    <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
  </a>
</section>
