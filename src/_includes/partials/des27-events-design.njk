{# Events page design by Cici (hero, featured band, carousel, archive). #}
{% set featured = events | featuredEvent %}
{% set upcoming = events | upcomingEvents | rejectattr("featured") %}
{% set past = events | pastEvents %}

{# ---------- Hero ---------- #}
{% set heroScript = "Events" %}
{% set heroTags = ["Workshops", "talks", "exhibitions", "&amp; more"] %}
{% set heroIntro = ["A space for", "design, people,", "and experimentation."] %}
{% include "partials/des27-hero.njk" %}

{# ---------- Featured event ---------- #}
{% if featured %}
<section class="ev-featured" data-cursor="light" aria-labelledby="featured-title">
  <div class="ev-featured__glow" aria-hidden="true"></div>

  <svg class="ev-featured__curve draw-line" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path pathLength="1" d="M400 20 C 250 40, 150 120, 120 260 C 105 330, 70 380, 10 420" />
  </svg>

  <div class="ev-featured__media" data-parallax>
    {% if featured.image %}
      <img src="{{ featured.image }}" alt="" loading="lazy">
    {% else %}
      <div class="media-placeholder"></div>
    {% endif %}
  </div>

  <div class="des-container ev-featured__inner">
    <div class="ev-featured__content">
      <p class="ev-eyebrow reveal">Featured event</p>
      <h2 id="featured-title" class="ev-featured__title">
        <span class="ev-featured__big reveal" style="--delay: 100ms">{{ featured.headline or featured.title }}</span>
        {% if featured.headlineAccent %}<span class="script ev-featured__script reveal" style="--delay: 220ms">{{ featured.headlineAccent }}</span>{% endif %}
      </h2>
      <p class="ev-featured__text reveal" style="--delay: 320ms">{{ featured.summary }}</p>

      <a class="ev-btn ev-btn--lime reveal" data-magnetic style="--delay: 420ms" href="{{ (featured.registration and featured.registration.url) or ('/events/' + featured.id + '/') }}">
        {% if featured.registration and featured.registration.status == "open" %}Sign Up Now{% else %}Find Out More{% endif %}
        <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path pathLength="1" d="M4 12 12 4M5.5 4H12v6.5" /></svg>
      </a>
    </div>

    <p class="ev-featured__date reveal" style="--delay: 200ms">
      <time datetime="{{ featured.date }}">
        <span class="ev-featured__month">{{ featured.dateDisplay.big if featured.dateDisplay else (featured.date | datePart("month")) }}</span>
        <span class="ev-featured__day script">{{ featured.dateDisplay.script if featured.dateDisplay else (featured.date | datePart("day")) }}</span>
      </time>
    </p>
  </div>
</section>
{% endif %}

{# ---------- Upcoming ---------- #}
<section class="ev-upcoming" aria-labelledby="upcoming-title">
  <svg class="ev-upcoming__line draw-line" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path pathLength="1" d="M1090 -10 C 1060 120, 980 170, 880 200 C 720 250, 560 210, 420 170" />
  </svg>
  <svg class="ev-upcoming__swoosh" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path pathLength="1" d="M-40 260 C 200 160, 380 180, 520 250" />
    <path pathLength="1" d="M-40 980 C 240 820, 420 780, 620 820" />
  </svg>

  <div class="des-container ev-upcoming__inner">
    <div class="ev-upcoming__intro">
      <h2 id="upcoming-title" class="ev-heading reveal">
        <span class="ev-heading__big">Upcoming</span>
        <span class="ev-heading__script script">Events</span>
      </h2>
      <p class="ev-upcoming__text reveal" style="--delay: 150ms">Workshops,<br>talks,<br>industry nights<br>and social events.</p>
    </div>

    <div class="ev-carousel" data-carousel>
      {% if upcoming.length %}
        <ul class="ev-carousel__track" data-cursor-label="Drag" data-carousel-track>
          {% for event in upcoming %}
            <li class="ev-card reveal" data-tilt style="--delay: {{ loop.index0 * 90 }}ms">
              <div class="ev-frame">
                <div class="ev-card__media">
                  {% if event.registration %}<span class="ed-pill ed-pill--{{ event.registration.status }} ev-card__status">{{ event.registration.status | registrationLabel }}</span>{% endif %}
                  {% if event.image %}<img src="{{ event.image }}" alt="" loading="lazy" draggable="false">{% endif %}
                </div>
              </div>
              <div class="ev-card__body">
                <h3 class="ev-card__title"><a href="/events/{{ event.id }}/">{{ event.title }}</a></h3>
                <dl class="ev-card__meta">
                  <div>
                    <dt class="visually-hidden">Date</dt>
                    <dd>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12" rx="1.5"/><path pathLength="1" d="M3 8.5h14M7 2.5v4M13 2.5v4M6.5 11.5h3"/></svg>
                      <time datetime="{{ event.date }}">{{ event.date | datePart("month") }} <strong>{{ event.date | datePart("day") }}</strong> ({{ event.date | datePart("weekday") }})</time>
                    </dd>
                  </div>
                  <div>
                    <dt class="visually-hidden">Location</dt>
                    <dd>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path pathLength="1" d="M10 17.5s-5.5-5-5.5-9a5.5 5.5 0 0 1 11 0c0 4-5.5 9-5.5 9Z"/><circle cx="10" cy="8.5" r="2"/></svg>
                      {{ event.location or "TBC" }}
                    </dd>
                  </div>
                </dl>
                <a class="ev-card__link" href="/events/{{ event.id }}/" aria-label="View details: {{ event.title }}">
                  <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path pathLength="1" d="M4 12 12 4M5.5 4H12v6.5" /></svg>
                </a>
              </div>
            </li>
          {% endfor %}
        </ul>

        <div class="ev-carousel__controls">
          <button class="ev-carousel__btn" data-magnetic type="button" data-carousel-prev aria-label="Previous events">
            <svg viewBox="0 0 24 12" aria-hidden="true"><path pathLength="1" d="M22 6H3M8 1 3 6l5 5" /></svg>
          </button>
          <div class="ev-carousel__dots" data-carousel-dots></div>
          <button class="ev-carousel__btn" data-magnetic type="button" data-carousel-next aria-label="Next events">
            <svg viewBox="0 0 24 12" aria-hidden="true"><path pathLength="1" d="M2 6h19M16 1l5 5-5 5" /></svg>
          </button>
        </div>
      {% else %}
        <p class="empty-state">No upcoming events right now.</p>
      {% endif %}
    </div>
  </div>
</section>

{# ---------- Archive ---------- #}
<section class="ev-archive" aria-labelledby="archive-title">
  <div class="des-container">
    <hr class="ev-rule">

    {% if past.length %}
      <div class="ev-archive__stage" data-archive>
        <button data-magnetic class="ev-archive__nav ev-archive__nav--prev" type="button" data-archive-prev aria-label="Previous event">
          <svg viewBox="0 0 60 50" aria-hidden="true"><path pathLength="1" d="M58 4C40 2 20 8 10 40M3 30l7 12 11-7" /></svg>
        </button>

        <ul class="ev-archive__stack" data-archive-stack>
          {% for event in past %}
            <li class="ev-archive__item" data-archive-item>
              <figure>
                {% if event.image %}<img src="{{ event.image }}" alt="" loading="lazy" draggable="false">{% else %}<div class="media-placeholder"></div>{% endif %}
                <figcaption>
                  <span>{{ event.title }}</span>
                  <time datetime="{{ event.date }}">{{ event.date | readableDate }}</time>
                </figcaption>
              </figure>
              <a class="ev-archive__link" href="/events/{{ event.id }}/" aria-label="{{ event.title }} recap and photos" tabindex="-1">
                <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path pathLength="1" d="M4 12 12 4M5.5 4H12v6.5" /></svg>
              </a>
            </li>
          {% endfor %}
        </ul>

        <button data-magnetic class="ev-archive__nav ev-archive__nav--next" type="button" data-archive-next aria-label="Next event">
          <svg viewBox="0 0 60 50" aria-hidden="true"><path pathLength="1" d="M2 4c18-2 38 4 48 36M57 30l-7 12-11-7" /></svg>
        </button>
      </div>
    {% endif %}

    <h2 id="archive-title" class="ev-heading ev-heading--center reveal">
      <span class="ev-heading__big">Event</span>
      <span class="ev-heading__script script">Archive</span>
    </h2>

    {% if past.length %}
      <ol class="ed-past-list" aria-label="All past events, newest first">
        {% for event in past %}
          <li class="reveal" style="--delay: {{ loop.index0 * 70 }}ms">
            <a href="/events/{{ event.id }}/">
              <time datetime="{{ event.date }}">{{ event.date | readableDate }}</time>
              <span class="ed-past-list__title">{{ event.title }}</span>
              <span class="ed-past-list__meta">{% if event.gallery and event.gallery.length %}{{ event.gallery.length }} photos{% else %}Recap{% endif %}</span>
              <svg class="ev-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5" /></svg>
            </a>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>
