<footer class="des-footer">
  <div class="des-container des-footer__inner">
    <a class="des-logo" href="/" aria-label="DES home"><span class="des-logo__mark" aria-hidden="true"></span></a>

    <nav aria-label="Footer">
      <ul class="des-footer__links">
        {% for link in site.des27Nav %}
          <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <p class="des-footer__legal">&copy; {% year %} {{ site.name }} · Font: Codec Pro Family by <a href="http://www.zetafonts.com/collection/3809">Zetafonts</a></p>
  </div>
</footer>
